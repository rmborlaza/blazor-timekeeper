@inject TimekeepingTransactionsDb TransactionsDb

<button @onclick="TimeInAsync" class="btn btn-success" disabled="@(!canTimeIn)">Time In</button>
<button @onclick="TimeOutAsync" class="btn btn-danger" disabled="@canTimeIn">Time Out</button>

@code {
    [Parameter]
    public Employee Employee { get; set; }

    [Parameter]
    public List<TimekeepingTransaction> Transactions { get; set; }

    [Parameter]
    public EventCallback TimeSubmitted { get; set; }

    private bool canTimeIn = false;

    protected override void OnParametersSet()
    {
        if (Employee != null && Transactions != null)
        {
            try
            {
                if (Transactions?.Count > 0)
                {
                    canTimeIn = Transactions[0].TransactionType.TransactionTypeName == "OUT";
                }
                else
                {
                    canTimeIn = true;
                }
            }
            catch (Exception ex)
            {
                HandleException(ex);
            }
        }
    }

    private async Task TimeInAsync()
    {
        try
        {
            await AddTransactionAsync("IN");

            canTimeIn = false;
            StateHasChanged();

            await TimeSubmitted.InvokeAsync();
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    private async Task TimeOutAsync()
    {
        try
        {
            await AddTransactionAsync("OUT");

            canTimeIn = true;
            StateHasChanged();

            await TimeSubmitted.InvokeAsync();
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    private async Task AddTransactionAsync(string transactionTypeName)
    {
        var transaction = new TimekeepingTransaction();
        transaction.TransactionDateTime = DateTime.UtcNow;
        transaction.TransactionType = new TransactionType { TransactionTypeName = transactionTypeName };
        transaction.EmployeeId = Employee.EmployeeId;

        await TransactionsDb.AddTransactionAsync(transaction);
    }

    private void HandleException(Exception ex)
    {
        Debug.WriteLine(ex.Message);
        Debugger.Break();
    }
}
