@rendermode InteractiveServer
@inject EmployeeDb EmployeeDb

<table class="table table-striped">
    <thead>
        <tr>
            <td>Employee ID</td>
            <td>Full Name</td>
            <td>Username</td>
            <td>Email</td>
            <td>Account Type</td>
            <td>Date Hired</td>
        </tr>
    </thead>
    <tbody>
        @if (employees == null)
        {
            <tr>
                <td colspan="6">
                    <em>Loading...</em>
                </td>
            </tr>
        }
        else if (employees.Count == 0)
        {
            <tr>
                <td colspan="4">
                    No records in the database.
                </td>
            </tr>
        }
        else
        {
            @foreach (var employee in employees)
            {
                <tr>
                    <td>@employee.EmployeeId</td>
                    <td>
                        <NavLink href=@($"/employees/view/{employee.EmployeeId}")>
                            @employee.FirstName @employee.LastName
                        </NavLink>
                    </td>
                    <td>@employee.Username</td>
                    <td>@employee.Email</td>
                    <td>@employee.AccountType.ToString()</td>
                    <td>@employee.DateHired.ToShortDateString()</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Employee> employees;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                employees = await EmployeeDb.GetEmployeesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Debug.WriteLine(ex.Message);
                Debugger.Break();
            }
        }
    }
}
