@* This form is no longer used *@

<EditForm Model="@Employee" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <InputText id="username" class="form-control" @bind-Value="@Employee.Username" />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="@Employee.Email" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="@clearPassword" />
    </div>

    <div class="mb-3">
        <label for="type" class="form-label">Account Type</label>
        <InputSelect class="form-select" @bind-Value="@accountType">
            <option value="0">Employee</option>
            <option value="1">Administrator</option>
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    [Parameter]
    public Employee Employee { get; set; }

    private string clearPassword;
    private int accountType;

    private void HandleValidSubmit()
    {
        Employee.AccountType = (AccountType)accountType;
        
        string passwordHashed = Password.CalculateHash(clearPassword);
        Employee.PasswordHash = passwordHashed;
    }
}
