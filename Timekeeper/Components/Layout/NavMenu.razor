@inject AuthenticationStateProvider AuthStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Timekeeper</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <CascadingAuthenticationState>
            <AuthorizeView>
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                            Login
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrator,Employee">
                <div class="nav-item px-3">
                    <span class="nav-item-neutral">
                        <strong>Hello, @name</strong>
                    </span>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@employeeLink" Match="NavLinkMatch.All">
                        My Account
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/logout">
                        Logout
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Administrator">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/employees" Match="NavLinkMatch.All">
                        @* <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> *@
                        Employees
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/time-logs" Match="NavLinkMatch.All">
                        @* <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> *@
                        Time Logs
                    </NavLink>
                </div>
            </AuthorizeView>
        </CascadingAuthenticationState>
    </nav>
</div>

@code {
    private string employeeLink;
    private string name;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var employeeIdClaim = user.Claims.FirstOrDefault(c => c.Type == "EmployeeId")?.Value;

        if (int.TryParse(employeeIdClaim, out int employeeId))
        {
            name = user.Identity.Name;
            employeeLink = $"/employees/view/{employeeId}";
        }
    }
}