<div class="alert alert-danger alert-dismissable fade show justify-content-between align-items-center d-flex d-none z-3" style="position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); width: auto;" role="alert">
    @Message
    <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

@code {
    [Parameter]
    public string Message { get; set; }

    public void Show(string message)
    {
        Message = message;
    }
}
