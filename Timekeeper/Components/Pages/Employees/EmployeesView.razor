@page "/employees/view/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject TimekeeperContext DbContext

<PageTitle>View Employee</PageTitle>
<h1>View Employee</h1>

<div class="row mb-3">
    <div class="col col-12 col-lg-6">
        <EmployeeCardComponent Employee="@employee" />
    </div>
</div>

<div class="row mb-3">
    <div class="col col-12">
        <NavLink class="btn btn-primary" href="@($"/employees/update/{employee.EmployeeId}")">
            Update Employee Details
        </NavLink>
        <button type="button" @onclick="DeleteEmployeeAsync" class="btn btn-outline-danger">Delete Employee</button>
    </div>
</div>

<div class="row">
    <div class="col col-12">
        @if (employee != null)
        {
            <div class="mb-3">
                <TimeLogButtonComponent Employee="@employee" TimeSubmitted="HandleSubmitAsync" />
            </div>
    
            <div>
                <TimeLogListComponent Employee="@employee" Transactions="@transactions" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Employee employee = new();
    private List<TimekeepingTransaction> transactions;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            employee = await DbContext.Employees
                .Include(e => e.TimeKeepingTransactions)
                .ThenInclude(t => t.TransactionType)
                .FirstOrDefaultAsync(e => e.EmployeeId == Id);

            await LoadTransactionsAsync();
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    private async Task LoadTransactionsAsync()
    {
        transactions = await DbContext.TimeKeepingTransactions
            .Where(t => t.EmployeeId == employee.EmployeeId)
            .Include(t => t.Employee)
            .Include(t => t.TransactionType)
            .OrderByDescending(t => t.TransactionDateTime)
            .ToListAsync();
    }

    private async Task DeleteEmployeeAsync()
    {
        try
        {
            DbContext.Employees.Remove(employee);
            await DbContext.SaveChangesAsync();

            var unusedTransactionNames = await DbContext.TransactionType
                .Where(tt => !DbContext.TimeKeepingTransactions.Any(tr => tr.TransactionTypeId == tt.TransactionTypeId))
                .ToListAsync();
            if (unusedTransactionNames.Any())
            {
                DbContext.TransactionType.RemoveRange(unusedTransactionNames);
                await DbContext.SaveChangesAsync();
            }

            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    private async Task HandleSubmitAsync()
    {
        try
        {
            await LoadTransactionsAsync();
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    private void HandleException(Exception ex)
    {
        Debug.WriteLine(ex.Message);
        Debugger.Break();
    }
}
