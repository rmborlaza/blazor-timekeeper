@page "/employees/update/{id:int}"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject EmployeeDb EmployeeDb
@inject ILogger<EmployeesUpdate> Logger;

<PageTitle>Update Employee Information</PageTitle>
<h1>Update Employee Information</h1>

@if (employee != null)
{
    <div class="row">
        <div class="col col-12">
            <EmployeeFormComponent 
                IsUpdateMode="true" 
                Employee="@employee" 
                OnFormComplete="HandleFormCompletion" />
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Employee employee;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            employee = await EmployeeDb.GetEmployeeAsync(Id, new List<Type> { typeof(Address) });
            if (employee == null)
            {
                NavManager.NavigateTo($"/employees");
            }
        }
        catch (Exception ex)
        {
            Logger.LogCritical(ex, "Exception thrown in EmploeesUpdate");
            Debug.WriteLine(ex.Message);
            Debugger.Break();
        }
    }

    private void HandleFormCompletion()
    {
        NavManager.NavigateTo($"/employees/view/{employee.EmployeeId}");
    }
}
