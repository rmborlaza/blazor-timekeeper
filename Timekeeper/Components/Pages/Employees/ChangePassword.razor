@using System.Security.Claims
@using Timekeeper.Services.AuthenticationService
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject EmployeeDb EmployeeDb
@page "/employees/change-password/{id:int}"

<div class="row">
    <div class="col col-12 col-md-6 col-xl-4">
        <div class="card">
            <div class="card-header">
                <span class="h3">Change Password</span>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    Employee: @employee.FirstName @employee.LastName
                </div>
                
                <EditForm Model="@loginModel" OnValidSubmit="HandleSubmitAsync" FormName="ChangePwForm">
                    <div class="row mb-3">
                        <div class="col col-12">
                            <label for="password">New Password</label>
                            <InputText type="password" id="password" @bind-Value="@loginModel.Password" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col col-12">
                            <button type="submit" class="btn btn-primary">Change Password</button>
                            <NavLink href="@($"/employees/view/{Id}")" class="btn btn-secondary">Cancel</NavLink>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private LoginModel loginModel { get; set; } = new();

    private Employee employee { get; set; } = new();
    private bool canChangePw;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            NavManager.NavigateTo("/");
            return;
        }

        var viewerRole = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
        var viewerId = user.Claims.FirstOrDefault(c => c.Type == "EmployeeId")?.Value;

        int.TryParse(viewerId, out int vId);

        canChangePw = vId == Id;

        if (!canChangePw && viewerRole != "Administrator")
        {
            NavManager.NavigateTo($"/employees/view/{vId}");
            return;
        }

        employee = await EmployeeDb.GetEmployeeAsync(Id);
    }

    private async Task HandleSubmitAsync()
    {
        await EmployeeDb.ChangePasswordAsync(Id, loginModel.Password);
        NavManager.NavigateTo($"/employees/view/{Id}");
    }

    private void HandleException(Exception ex)
    {
        Debug.WriteLine(ex.Message);
        Debugger.Break();
    }
}
