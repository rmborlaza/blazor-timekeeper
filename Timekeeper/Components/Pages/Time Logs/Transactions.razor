@page "/time-logs"
@rendermode InteractiveServer
@inject TimekeepingTransactionsDb TransactionsDb
@inject ILogger<Transactions> Logger;

<PageTitle>Time Logs</PageTitle>
<h1>Time Logs</h1>

<TimeLogListComponent Transactions="@transactions" />

@code {
    private List<TimekeepingTransaction> transactions;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            transactions = await TransactionsDb.GetTimekeepingTransactionsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogCritical(ex, "Exception thrown in Transactions");
            Debug.WriteLine(ex.Message);
            Debugger.Break();
        }
    }
}
