@page "/employees/update/{id:int}"
@inject TimekeeperContext DbContext

<PageTitle>Update Employee Information</PageTitle>
<h1>Update Employee Information</h1>

<EmployeeFormComponent IsUpdateMode="true" Employee="@Employee" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Employee Employee = new();

    protected override async Task OnParametersSetAsync()
    {
        Employee = await DbContext.Employees.FirstOrDefaultAsync(e => e.EmployeeId == Id);
    }
}
