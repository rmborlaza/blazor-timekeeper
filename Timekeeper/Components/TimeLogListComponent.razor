@rendermode InteractiveServer
@inject TimekeeperContext DbContext

<div class="mt-3 col-12">
    <table class="table table-striped">
        <thead>
            <tr>
                <td>Date & Time</td>
                <td>Employee Name</td>
                <td>Action</td>
            </tr>
        </thead>
        <tbody>
            @if (transactions == null)
            {
                <tr>
                    <td colspan="3">
                        <em>Loading...</em>
                    </td>
                </tr>
            }
            else if (transactions.Count == 0)
            {
                <tr>
                    <td colspan="3">
                        No records in the database.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var transaction in transactions)
                {
                    @if (transaction != null && transaction.Employee != null)
                    {
                        <tr>
                            <td>@transaction.TransactionDateTimeLocal.ToString()</td>
                            <td>
                                <NavLink href=@($"/employees/view/{transaction.Employee.EmployeeId}")>
                                    @transaction.Employee.FirstName @transaction.Employee.LastName
                                </NavLink>
                            </td>
                            <td>@transaction.TransactionType.TransactionTypeName</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public Employee Employee { get; set; }

    private List<TimekeepingTransaction> transactions;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Employee != null)
        {
            transactions = await DbContext.TimeKeepingTransactions
                .Where(t => t.EmployeeId == Employee.EmployeeId)
                .Include(t => t.TransactionType)
                .Include(t => t.Employee)
                .OrderByDescending(t => t.TransactionDateTime)
                .ToListAsync();
        }
        else
        {
            transactions = await DbContext.TimeKeepingTransactions
                .Include(t => t.TransactionType)
                .Include(t => t.Employee)
                .OrderByDescending(t => t.TransactionDateTime)
                .ToListAsync();
        }
        StateHasChanged();
    }
}
